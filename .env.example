# Copie para .env e ajuste. O arquivo .env NÃO vai para o GitHub.
# (Comentários só em linhas próprias, começando com #.)

APP_NOME="APAE de Rio do Sul"

# production oculta mensagens técnicas de erro
APP_ENV=development

# Endereço público, usado no QR Code (ex.: https://apae-avaliacao.onrender.com)
APP_URL=

# Só se o detector automático de subpasta falhar (ex.: XAMPP)
# APP_BASE_PATH=/apae/public

# Banco: use DATABASE_URL OU as variáveis DB_*
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apae
DB_USER=postgres
DB_PASSWORD=

# Primeiro administrador (criado por scripts/migrate.php se não houver usuários)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@apae.org.br
ADMIN_SENHA=troque-esta-senha

# Atrás de proxy (Render, Railway…): 1 para ler o IP real no limite de login
TRUST_PROXY=0
